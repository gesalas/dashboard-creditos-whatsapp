# Copia este archivo como secrets.toml (en local) o pega su contenido en Settings > Secrets (Streamlit Cloud).
# secrets.toml NUNCA se sube al repositorio (.gitignore lo excluye).

[acceso]
# Frase larga al azar para firmar el "recordarme". Si cambia, todos tienen que volver a iniciar sesión.
clave_sesion = "cambia-esto-por-una-frase-larga-al-azar"

[correo]
servidor = "smtp.gmail.com"
puerto = 465
usuario = "cuenta.del.dashboard@gmail.com"
clave = "contraseña de aplicación de Gmail (16 letras)"
remitente = "Créditos de mensajería · Equipo CRM"

[github]
# Token de grano fino creado por el dueño del repositorio: solo este repositorio, permiso Contents: Read and write.
token = "github_pat_..."
repositorio = "gesalas/dashboard-creditos-whatsapp"
rama_app = "main"
rama_datos = "datos-acceso"
